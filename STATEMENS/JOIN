SELECT 
NOMBRE,
SUM (CANTIDAD) AS TOTAL_COMPRADO
FROM CLIENTES
JOIN VENTAS
ON CLIENTES.CLIENTE_ID = VENTAS.CLIENTE_ID
GROUP BY NOMBRE
ORDER BY TOTAL_COMPRADO DESC;

SELECT 
NOMBRE_PRODUCTO,
SUM (VENTAS.CANTIDAD) AS TOTAL_VENDIDO
FROM PRODUCTOS
INNER JOIN VENTAS
ON PRODUCTOS.PRODUCTO_ID = VENTAS.PRODUCTO_ID
GROUP BY NOMBRE_PRODUCTO
ORDER BY TOTAL_VENDIDO DESC;

SELECT 
CLIENTES.NOMBRE,
PRODUCTOS.NOMBRE_PRODUCTO,
SUM (VENTAS.CANTIDAD) AS TOTAL_COMPRADO
FROM VENTAS
JOIN CLIENTES
ON CLIENTES.CLIENTE_ID = VENTAS.CLIENTE_ID
JOIN PRODUCTOS
ON PRODUCTOS.PRODUCTO_ID = VENTAS.PRODUCTO_ID
GROUP BY NOMBRE,NOMBRE_PRODUCTO
ORDER BY TOTAL_COMPRADO DESC