SELECT CLIENTE_ID,
SUM (CANTIDAD) AS CANTIDAD_TOTAL
FROM VENTAS
GROUP BY CLIENTE_ID
HAVING SUM (CANTIDAD)>5;

SELECT CLIENTE_ID,
COUNT (VENTAS_ID) AS VENTAS_REALIZADAS
FROM VENTAS
GROUP BY CLIENTE_ID
HAVING COUNT (VENTAS_ID)>1;

SELECT CATEGORIA,
ROUND(AVG(PRECIO),2) AS PRECIO_PROMEDIO
FROM PRODUCTOS
GROUP BY CATEGORIA
HAVING AVG (PRECIO)<50;