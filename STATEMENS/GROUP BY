SELECT CLIENTE_ID,
COUNT (CANTIDAD) AS CANTIDAD_TOTAL
FROM VENTAS
GROUP BY CLIENTE_ID
ORDER BY CANTIDAD_TOTAL DESC;


SELECT CLIENTE_ID,
SUM (CANTIDAD) AS CANTIDAD_TOTAL
FROM VENTAS
GROUP BY CLIENTE_ID
ORDER BY CANTIDAD_TOTAL DESC;


SELECT CATEGORIA,
MAX (PRECIO) AS VALOR_MAXIMO
FROM PRODUCTOS
GROUP BY CATEGORIA
ORDER BY VALOR_MAXIMO DESC;